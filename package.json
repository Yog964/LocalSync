{
  "name": "localsync",
  "version": "1.0.0",
  "description": "Offline Peer-to-Peer File Sharing System over WiFi",
  "private": true,
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:all": "npm run install:server && npm run install:client",
    "dev:server": "cd server && node index.js",
    "dev:client": "cd client && npm run dev",
    "build:client": "cd client && npm run build",
    "start": "cd server && node index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop localsync",
    "pm2:restart": "pm2 restart localsync",
    "setup": "npm run install:all && npm run build:client"
  },
  "keywords": ["file-sharing", "offline", "wifi", "local-network"],
  "author": "Sushant",
  "license": "MIT"
}
